{
  "manifest_version": 3,
  "name": "Newsletter Aggregator - Save URL",
  "description": "Save any webpage to your Newsletter Aggregator, and sync your Substack and X sessions to it.",
  "version": "1.1.0",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to Newsletter Aggregator"
  },
  "permissions": [
    "activeTab",
    "cookies",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://substack.com/*",
    "https://x.com/*"
  ],
  "optional_host_permissions": [
    "https://*.ts.net/*"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}
