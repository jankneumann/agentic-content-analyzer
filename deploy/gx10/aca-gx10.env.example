# /etc/aca/aca.env for the gx-10 host — TEMPLATE.
#
# Read by aca-api.service (EnvironmentFile=) and passed to
# `docker compose --env-file` for deploy/gx10/docker-compose.gx10.yml.
# Install root-owned, mode 0600:
#   sudo install -m 0600 -o root -g root deploy/gx10/aca-gx10.env.example /etc/aca/aca.env
#
# See docs/TAILNET.md. Replace every <placeholder>; never commit the result.

# --- Bind addresses ---------------------------------------------------------
# 127.0.0.1 is the recommended value for both: `tailscale serve` is the only
# path in from the tailnet. The alternative is gx-10's Tailscale IPv4
# (`tailscale ip -4`). Never 0.0.0.0, never a LAN address.
ACA_API_HOST=127.0.0.1
ACA_BAO_BIND_ADDR=127.0.0.1
PORT=8000

# Peers allowed to set X-Forwarded-For. 127.0.0.1 = tailscale serve only.
# With the direct-bind alternative there is no proxy: keep 127.0.0.1.
ACA_FORWARDED_ALLOW_IPS=127.0.0.1

# --- Application ------------------------------------------------------------
ENVIRONMENT=production
# Browser origins that call the API cross-origin: the web UI on the MagicDNS
# name, plus the extension origin until it declares a host permission.
ALLOWED_ORIGINS=https://gx-10.<tailnet>.ts.net:8443,chrome-extension://<extension-id>
ADMIN_API_KEY=<admin-api-key>

# --- OpenBao ----------------------------------------------------------------
# Processes ON gx-10 (API, worker, `aca backup run`) use loopback. The
# workstation uses https://gx-10.<tailnet>.ts.net:8200 instead.
BAO_ADDR=http://127.0.0.1:8200
BAO_ROLE_ID=<approle-role-id>
BAO_SECRET_ID=<approle-secret-id>
