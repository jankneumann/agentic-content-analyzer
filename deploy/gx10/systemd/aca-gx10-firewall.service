[Unit]
Description=GX-10 private network and direct-route guard
Requires=docker.service aca-gx10-proxy-policy.service
After=docker.service aca-gx10-proxy-policy.service
Before=aca-gx10.service

[Service]
Type=oneshot
WorkingDirectory=/opt/aca
Environment=GX10_ROOT_DIR=/opt/aca
ExecStart=/opt/aca/scripts/gx10/install_firewall.sh
RemainAfterExit=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
