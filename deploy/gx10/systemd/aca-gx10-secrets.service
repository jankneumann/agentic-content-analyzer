[Unit]
Description=GX-10 OpenBao runtime secret rendering
Requires=docker.service
After=docker.service network-online.target
Before=aca-gx10-proxy-policy.service aca-gx10.service

[Service]
Type=oneshot
WorkingDirectory=/opt/aca
Environment=GX10_ROOT_DIR=/opt/aca
Environment=GX10_RUNTIME_DIR=/run/aca/gx10
ExecStartPre=/usr/bin/docker compose -f /opt/aca/docker-compose.gx10.yml up -d openbao
ExecStart=/opt/aca/deploy/gx10/openbao/render-secrets.sh
RemainAfterExit=yes
UMask=0077
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/run/aca/gx10 /srv/aca/openbao
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
