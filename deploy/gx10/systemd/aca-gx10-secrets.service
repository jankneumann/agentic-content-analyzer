[Unit]
Description=GX-10 authenticated OpenBao runtime secret rendering
Requires=aca-gx10-image-pins.service aca-gx10-openbao-container.service
After=network-online.target aca-gx10-image-pins.service aca-gx10-openbao-container.service
Before=aca-gx10-proxy-policy.service aca-gx10.service

[Service]
Type=oneshot
WorkingDirectory=/opt/aca
EnvironmentFile=/etc/aca/gx10-images.env
EnvironmentFile=-/etc/aca/gx10-public.env
Environment=GX10_ROOT_DIR=/opt/aca
Environment=GX10_RUNTIME_DIR=/run/aca/gx10
Environment=GX10_BAO_ADDR=http://127.0.0.1:18200/v1
LoadCredential=bao-bootstrap-token:/etc/aca/gx10/bao-bootstrap-token
LoadCredential=bao-unseal-key:/etc/aca/gx10/bao-unseal-key
ExecStartPre=/opt/aca/deploy/gx10/openbao/unseal.sh
ExecStartPre=/opt/aca/deploy/gx10/openbao/bootstrap-approle.sh
ExecStartPre=/opt/aca/deploy/gx10/openbao/login-approle.sh
ExecStart=/opt/aca/deploy/gx10/openbao/render-secrets.sh
RemainAfterExit=yes
UMask=0077
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/run/aca/gx10 /srv/aca/openbao
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
