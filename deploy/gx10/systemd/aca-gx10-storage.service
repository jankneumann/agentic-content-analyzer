[Unit]
Description=GX-10 bounded persistent storage monitor
Requires=aca-gx10.service
Requires=aca-gx10-maintenance-plans.service
After=aca-gx10.service
After=aca-gx10-maintenance-plans.service
OnFailure=aca-gx10-maintenance-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=/opt/aca
# This process reserves its operation in the application database before
# doing any work, and the host cannot resolve container names. The renderer
# writes the same credentials against the database's fixed stateful address.
EnvironmentFile=/run/aca/gx10/host-maintenance.env
# podman-compose parses the overlay on every call, and the overlay demands
# GX10_APP_IMAGE and the reviewed digests. Without them the parse fails
# before any container is touched, which is every producer that is not a
# plain tar.
EnvironmentFile=/etc/aca/gx10-images.env
StateDirectory=aca/gx10
StateDirectoryMode=0700
ExecStart=/opt/aca/.venv/bin/python -m scripts.gx10.storage --filesystem /srv/aca --concurrency 8 --actions /etc/aca/gx10/storage-actions.json --state-file /var/lib/aca/gx10/storage-controller.json --max-cycles 1
TimeoutStartSec=50
UMask=0077
PrivateTmp=yes
NoNewPrivileges=yes
# full, not strict: this unit drives rootful Podman, which writes container
# state under /var/lib/containers and /run. `strict` mounts the whole
# hierarchy read-only, so every producer that touches a container failed
# while the one that only tars a directory succeeded. /usr and /etc stay
# read-only.
ProtectSystem=full
# Containers this unit restarts -- the stores are stopped for a consistent
# copy -- put their conmon in this unit's cgroup. A oneshot's default kill
# would take them down again the moment the backup finished.
KillMode=process
# read-only, not yes: ExecStart runs /opt/aca/.venv/bin/python, which is a
# symlink into uv's interpreter under /root. ProtectHome=yes empties /root,
# so the exec fails with 203/EXEC before any code runs -- the unit reports a
# failure with nothing in the journal to explain it.
ProtectHome=read-only
ReadWritePaths=/var/lib/aca/gx10
RestrictSUIDSGID=yes
LockPersonality=yes
