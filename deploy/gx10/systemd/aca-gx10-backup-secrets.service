[Unit]
Description=GX-10 dedicated backup and restore OpenBao material renderer
Requires=aca-gx10-secrets.service
After=aca-gx10-secrets.service network-online.target
Before=aca-gx10-backup.service aca-gx10-restore-drill.service
OnFailure=aca-gx10-maintenance-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=/opt/aca
Environment=GX10_RUNTIME_DIR=/run/aca/gx10
Environment=GX10_BAO_ADDR=http://127.0.0.1:18200/v1
Environment=GX10_BAO_BACKUP_PATH=secret/newsletter/gx10/backup
LoadCredential=bao-bootstrap-token:/etc/aca/gx10/bao-bootstrap-token
ExecStart=/opt/aca/deploy/gx10/openbao/bootstrap-backup-approle.sh
ExecStart=/opt/aca/deploy/gx10/openbao/login-backup-approle.sh
ExecStart=/opt/aca/deploy/gx10/openbao/render-backup-secrets.sh
TimeoutStartSec=120
UMask=0077
PrivateTmp=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/run/aca/gx10
RestrictSUIDSGID=yes
LockPersonality=yes
