# EnvironmentFile for aca-backup.service — TEMPLATE.
#
# Install as /etc/aca/backup.env, root-owned, mode 0600:
#   sudo install -m 0600 -o root -g root aca-backup.env.example /etc/aca/backup.env
#   sudo $EDITOR /etc/aca/backup.env
#
# Two things this file must NOT contain, for the same reason:
#
#   BACKUP_AGE_IDENTITY_PATH   the private key that decrypts the backups
#   the identity key itself    likewise
#
# The gx-10 host holds the RECIPIENT (a public key) so it can encrypt, and does
# not hold the identity, so compromising this host does not yield the plaintext of
# every backup it ever wrote. Restore and `aca backup verify` are operator-
# initiated and supply the identity themselves.
#
# The credential below should be a WRITE credential scoped to the backup prefix,
# with no delete permission. The application tier uses these same two setting
# names with a different value — a credential that can read only the manifest key.
# One namespace, two values, per design D11.

BACKUP_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
BACKUP_S3_BUCKET=aca-backups
BACKUP_S3_REGION=auto
BACKUP_S3_PREFIX=aca
BACKUP_S3_ACCESS_KEY_ID=<write-scoped-access-key-id>
BACKUP_S3_SECRET_ACCESS_KEY=<write-scoped-secret-access-key>

# Public age recipient. Safe here; safe in a git-tracked runbook; safe anywhere.
BACKUP_AGE_RECIPIENT=age1<public-recipient-key>

# The database and graph endpoints the backup reads. These come from the profile
# in the normal case; override only when the host reaches them differently.
# DATABASE_URL=postgresql://aca:<password>@127.0.0.1:5432/newsletters
