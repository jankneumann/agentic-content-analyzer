{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aca.invalid/schemas/release-smoke-evidence-v1.json",
  "title": "ACA release smoke evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "target",
    "started_at",
    "finished_at",
    "frontend",
    "api",
    "checks",
    "retired_route_count",
    "assets",
    "operation",
    "result",
    "failure_codes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "target": {
      "enum": ["production", "staging", "ephemeral", "local"]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "frontend": {
      "$ref": "#/$defs/surface"
    },
    "api": {
      "$ref": "#/$defs/surface"
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "surface", "status"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "surface": {
            "enum": ["api", "cli", "frontend", "mutation", "evidence"]
          },
          "status": {
            "enum": ["passed", "failed", "skipped"]
          }
        }
      }
    },
    "retired_route_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000
    },
    "assets": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sha256", "size_bytes"],
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10485760
          }
        }
      }
    },
    "operation": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "status"],
          "properties": {
            "id": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,128}$"
                }
              ]
            },
            "status": {
              "enum": ["completed", "failed", "cancelled", "timed_out", "ambiguous"]
            }
          }
        }
      ]
    },
    "result": {
      "enum": ["passed", "failed"]
    },
    "failure_codes": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 32,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
      }
    }
  },
  "$defs": {
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "observed_revision",
        "revision_source",
        "expected_revision"
      ],
      "properties": {
        "origin": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^https?://(?:\\[[0-9A-Fa-f:]+\\]|[A-Za-z0-9.-]+)(?::[0-9]{1,5})?$",
              "maxLength": 255
            }
          ]
        },
        "observed_revision": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{40}|development)$"
            }
          ]
        },
        "revision_source": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "enum": [
                "railway_commit_sha",
                "github_sha",
                "verified_detached_sha",
                "local_development"
              ]
            }
          ]
        },
        "expected_revision": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "result": {
            "const": "passed"
          }
        },
        "required": ["result"]
      },
      "then": {
        "properties": {
          "frontend": {
            "properties": {
              "origin": {
                "type": "string"
              },
              "observed_revision": {
                "type": "string"
              },
              "revision_source": {
                "type": "string"
              }
            }
          },
          "api": {
            "properties": {
              "origin": {
                "type": "string"
              },
              "observed_revision": {
                "type": "string"
              },
              "revision_source": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  ]
}
