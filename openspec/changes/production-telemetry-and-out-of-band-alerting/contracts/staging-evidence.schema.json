{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-content-aggregator.local/schemas/workflow-alert-staging-evidence-v1.json",
  "title": "WorkflowAlertStagingEvidenceV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "environment_class",
    "revision",
    "revision_source",
    "operation_id",
    "attempt",
    "event_id",
    "outcome",
    "severity",
    "terminal_at",
    "received_at",
    "receipt_sha256",
    "delivery_count",
    "redaction_assertions"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "environment_class": {"const": "staging"},
    "revision": {"type": "string", "maxLength": 40, "pattern": "^[a-f0-9]{40}$"},
    "revision_source": {"const": "railway_commit_sha"},
    "operation_id": {"type": "string", "maxLength": 19, "pattern": "^[1-9][0-9]*$"},
    "attempt": {"type": "integer", "minimum": 1, "maximum": 2147483648},
    "event_id": {"type": "string", "format": "uuid", "maxLength": 36},
    "outcome": {"enum": ["partial", "zero_items", "failed", "unknown", "reconciled"]},
    "severity": {"enum": ["warning", "error"]},
    "terminal_at": {"type": "string", "format": "date-time", "maxLength": 35},
    "received_at": {"type": "string", "format": "date-time", "maxLength": 35},
    "receipt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "delivery_count": {"const": 1},
    "redaction_assertions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["no_secrets", "no_pii", "no_user_content", "no_raw_urls", "schema_valid"],
      "properties": {
        "no_secrets": {"const": true},
        "no_pii": {"const": true},
        "no_user_content": {"const": true},
        "no_raw_urls": {"const": true},
        "schema_valid": {"const": true}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"outcome": {"const": "failed"}}},
      "then": {"properties": {"severity": {"const": "error"}}},
      "else": {"properties": {"severity": {"const": "warning"}}}
    }
  ]
}
