{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aca.rotkohl.ai/schemas/operation-context-v1.json",
  "title": "OperationContextEnvelopeV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation_id",
    "root_operation_id",
    "parent_operation_id",
    "traceparent",
    "tracestate",
    "trace_id",
    "span_id",
    "claim_generation",
    "attempt_number",
    "entrypoint",
    "service_name",
    "service_instance_id",
    "environment",
    "release_revision",
    "stage",
    "resource_kind",
    "resource_key"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "operation_id": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$",
      "maxLength": 19
    },
    "root_operation_id": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$",
      "maxLength": 19
    },
    "parent_operation_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[1-9][0-9]*$",
      "maxLength": 19
    },
    "traceparent": {
      "type": "string",
      "minLength": 55,
      "maxLength": 512
    },
    "tracestate": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 512
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "span_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "claim_generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "attempt_number": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "entrypoint": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "service_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "service_instance_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "environment": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "release_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "stage": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "submit",
        "queue_wait",
        "claim",
        "fetch",
        "discover",
        "metadata",
        "transcript",
        "extract",
        "parse",
        "filter",
        "deduplicate",
        "model",
        "fallback",
        "persist",
        "index",
        "graph",
        "deliver",
        "backup",
        "restore",
        "alert",
        "cleanup",
        "flush"
      ]
    },
    "resource_kind": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 64
    },
    "resource_key": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    }
  }
}
