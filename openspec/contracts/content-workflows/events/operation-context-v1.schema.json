{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aca.rotkohl.ai/schemas/operation-context-v1.json",
  "title": "OperationContextEnvelopeV1",
  "$comment": "This schema enforces structure and scalar bounds. Every ingress MUST additionally call the generated composite semantic validator for traceparent/envelope identity, attempt_number = claim_generation + 1, and complete tracestate semantics.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation_id",
    "root_operation_id",
    "parent_operation_id",
    "traceparent",
    "tracestate",
    "trace_id",
    "span_id",
    "claim_generation",
    "attempt_number",
    "entrypoint",
    "service_name",
    "service_instance_id",
    "environment",
    "release_revision",
    "stage",
    "resource_kind",
    "resource_key"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "operation_id": {
      "type": "string",
      "pattern": "^([1-9][0-9]{0,17}|[1-8][0-9]{18}|9[01][0-9]{17}|92[01][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-7])$",
      "maxLength": 19
    },
    "root_operation_id": {
      "type": "string",
      "pattern": "^([1-9][0-9]{0,17}|[1-8][0-9]{18}|9[01][0-9]{17}|92[01][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-7])$",
      "maxLength": 19
    },
    "parent_operation_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^([1-9][0-9]{0,17}|[1-8][0-9]{18}|9[01][0-9]{17}|92[01][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-7])$",
      "maxLength": 19
    },
    "traceparent": {
      "type": "string",
      "pattern": "^00-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$",
      "minLength": 55,
      "maxLength": 55,
      "description": "Canonical W3C version-00 carrier; embedded trace/parent IDs must equal trace_id/span_id."
    },
    "tracestate": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 512,
      "pattern": "^[a-z0-9][a-z0-9_*/-]{0,255}=(?:[!-+\\--<>-~]|[!-+\\--<>-~][ -+\\--<>-~]{0,254}[!-+\\--<>-~])(,[a-z0-9][a-z0-9_*/-]{0,255}=(?:[!-+\\--<>-~]|[!-+\\--<>-~][ -+\\--<>-~]{0,254}[!-+\\--<>-~])){0,31}$",
      "description": "Optional comma-separated safe W3C simple-key tracestate subset; at most 32 members and 512 bytes."
    },
    "trace_id": {
      "type": "string",
      "pattern": "^(?!0{32}$)[0-9a-f]{32}$"
    },
    "span_id": {
      "type": "string",
      "pattern": "^(?!0{16}$)[0-9a-f]{16}$"
    },
    "claim_generation": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[01][0-9]{17}|92[01][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6])$",
      "maxLength": 19
    },
    "attempt_number": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^([1-9][0-9]{0,17}|[1-8][0-9]{18}|9[01][0-9]{17}|92[01][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-7])$",
      "maxLength": 19
    },
    "entrypoint": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "service_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "service_instance_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "environment": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "release_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "stage": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "submit",
        "queue_wait",
        "claim",
        "fetch",
        "discover",
        "metadata",
        "transcript",
        "extract",
        "parse",
        "filter",
        "deduplicate",
        "model",
        "fallback",
        "persist",
        "index",
        "graph",
        "deliver",
        "backup",
        "restore",
        "alert",
        "cleanup",
        "flush"
      ]
    },
    "resource_kind": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 64
    },
    "resource_key": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    }
  }
}
